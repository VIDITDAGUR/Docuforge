# Backend configuration
DOCUFORGE_MAX_UPLOAD_MB=30
DOCUFORGE_PPTX_MAX_UPLOAD_MB=50
DOCUFORGE_PPTX_CACHE_DIR=/tmp/docuforge_pptx_cache
DOCUFORGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gemini API & Assignment Answer Generator
GEMINI_API_KEY=your_google_ai_studio_api_key_here
DOCUFORGE_GEMINI_MODEL=gemini-3.5-flash
DOCUFORGE_ASSIGNMENT_MAX_UPLOAD_MB=20
DOCUFORGE_ASSIGNMENT_CACHE_DIR=/tmp/docuforge_assignment_cache

# Frontend configuration (optional if using a separate API domain in production)
VITE_API_BASE_URL=
